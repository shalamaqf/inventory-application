<%- include("partials/head", { title }) %>
<body>
    <%- include("partials/header") %>
    <main>
        <h1><%= title %></h1>
        <div class="update-genre-form-container">
            <form action="/genre/update-genre/<%= genre.id %>" method="post">
                <div class="input-field-container">
                    <label for="genre">Genre:</label>
                    <input type="text" name="genre" id="genre" value="<%= genre.name %>" required>
                </div>
                <div class="update-container">
                    <input type="text" name="adminPassword" placeholder="Admin Password" required>
                    <button type="submit">Update</button>
                </div>
            </form>
        </div>
    </main>
    <%- include("partials/footer") %>
</body>