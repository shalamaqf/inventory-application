<%- include("partials/head", { title }) %>
<body>
    <%- include("partials/header") %>
    <main>
        <h1><%= title %></h1>
        <div class="add-genre-form-container">
            <form action="/genre/<%= genre.name %>/add-album" method="post">
                <div class="input-field-container">
                    <label for="album-name">Name:</label>
                    <input type="text" name="album-name" id="album-name" required>
                </div>
                <div class="input-field-container">
                    <label for="artist">Artist:</label>
                    <input type="text" name="artist" id="artist" required>
                </div>
                <div class="input-field-container">
                    <label for="release-year">Release Year:</label>
                    <input type="text" name="release-year" id="release-year" required>
                </div>
                <button type="submit">Add</button>
            </form>
        </div>
    </main>
    <%- include("partials/footer") %>
</body>