<%- include("partials/head", { title }) %>
<body>
    <%- include("partials/header") %>
    <main>
        <h1><%= title %></h1>
        <a class="add-genre" href="/genre/add-genre">Add Genre</a>
        <div class="genre-list">
            <% if (genreList) { %>
                <ul>
                    <% genreList.forEach(genre => { %>
                        <li><%= genre.name %></li>
                        <%- include("partials/updateAndDeleteGenre", { genre }) %>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </main>
    <%- include("partials/footer") %>
</body>